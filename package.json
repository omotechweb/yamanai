{
  "name": "yamannai",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "e2e": "node scripts/e2e.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.mjs\"",
    "electron:start": "electron .",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron . --url=http://localhost:3000\"",
    "sync:hakkinda": "node scripts/sync-hakkinda.mjs",
    "electron:icon": "node scripts/make-icon.mjs",
    "electron:build": "electron-builder --win"
  },
  "dependencies": {
    "autoprefixer": "^10.4.23",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "next-auth": "^4.24.13",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.yamanai.app",
    "productName": "YamanAI",
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "YamanAISetup.${ext}",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "language": "1055",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "shortcutName": "YamanAI",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
